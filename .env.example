# Copy to .env.local and fill in. Never commit .env.local.
#
# OAuth client ID from Google Cloud (type: "Chrome Extension"), e.g.
# 1234567890-abc123.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Public key that pins the extension ID, so it matches the OAuth client.
# Generate with `pnpm keygen` (prints this value and the extension ID).
VITE_EXTENSION_KEY=
